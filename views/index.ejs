<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <title>Document</title>
    <style>
        table,
        thead,
        th,
        tbody,
        tbody,
        tr,
        td {
            border: 1px solid;
            color: rgba(54, 78, 211, 0.747);
        }

        table {
            width: 50%;
            text-align: center;
            align-items: center;
        }

        .big-table {
            margin-top: 20px;
            width: 100%;
            display: flex;
            justify-content: center;
        }
    </style>
</head>

<body>
    <main>
        <form id="register" class="w-50 mx-auto p-3 rounded shadow mt-4" action="/" method="post">
            <h3 class="text-primary">shopping List</h3>
            <div class="form-group mt-3">
                <label class="text-primary" for="">Items</label>
                <input name="items" type="username" class="form-control">
            </div>
            <div class="form-group mt-3">
                <label class="text-primary" for="">Price</label>
                <input name="price" id="price" type="number" class="form-control">
            </div>
            <div class="form-group mt-3">
                <label class="text-primary" for="">Quality</label>
                <input id="quality" oninput="calculate()" name="quality" type="number" class="form-control">
            </div>
            <div class="form-group mt-3">
                <label class="text-primary" for="">Sub-Total</label>
                <input id="subtototal" name="subtototal" type="number" class="form-control">
            </div>
            <div class="text-center mt-3">
                <button type="submit" class="btn btn-primary w-50 fs-2">Add</button>
            </div>
        </form>
       
        <div class="big-table">
            <table class="">

                <thead>

                    <th>Items</th>
                    <th>Price</th>
                    <th>Quality</th>
                    <th>Subtototal</th>
                    <th>Delete</th>
                    <th>Edit</th>
                </thead>


                <tbody>
                    <% if (shopping && shopping.length> 0) { %>
                        <% shopping.forEach((ele,i)=> { %>
                            <tr class="w-50 mx-auto">
                                <td>
                                    <%= ele.items %>
                                </td>
                                <td>
                                    <%= ele.price %>
                                </td>
                                <td>
                                    <%= ele.quality %>
                                </td>
                                <td>
                                    <%= ele.subtototal %>
                                </td>
                                <td>
                                    <form action="/delete/<%= ele._id %>" method="post">
                                        <button class="btn btn-danger"> Delete</button>
                                    </form>
                                </td>
                                <td><button class="btn btn-primary"> Edit</button></td>

                            </tr>
                            <% }) %>
                                <% } %>

                </tbody>

            </table>
        </div>

        <div class="text-primary d-flex justify-content-center w-100 mt-3 align-items-center">
            <p class=" w-50"> <b> Total :</b> 
             <span>N<%=shopping.reduce((acc,ele)=> acc + ele.subtototal , 0 ) %></span> 
            </p>
            </div>



    </main>
</body>

</html>

<script>
    let subtototal = document.getElementById("subtototal")
    let quality = document.getElementById("quality")
    let price = document.getElementById("price")

    function calculate() {
        subtototal.value = quality.value * price.value
    }
</script>